@@ -0,0 +1,92 @@
+from typing import Optional
+
+from fastapi import APIRouter, HTTPException, UploadFile, File, Form
+
+from ..modules.ingestion.upload_handler import ingest_uploaded_drone_image
+from ..modules.ingestion.pipeline import IngestionPipeline
+from ..modules.building_extraction.extractor import BuildingFootprintExtractor
+from ..modules.road_extraction.extractor import RoadNetworkExtractor
+from ..modules.parcel_delineation.delineator import ParcelBoundaryDelineator
+from ..modules.landuse_classification.classifier import LandUseClassifier
+from ..modules.topology_conflict.engine import TopologyConflictEngine
+from ..modules.evaluation.evaluator import EvaluationSuite
+
+router = APIRouter()
+
+ALLOWED_CONTENT_TYPES = {"image/jpeg", "image/png", "image/tiff", "image/tif", "application/octet-stream"}
+MAX_UPLOAD_BYTES = 60 * 1024 * 1024  # 60 MB
+
+
+@router.post("/drone-image")
+async def upload_drone_image(
+    file: UploadFile = File(...),
+    center_lat: float = Form(...),
+    center_lon: float = Form(...),
+    width_m: float = Form(300.0),
+    height_m: float = Form(300.0),
+    name: Optional[str] = Form(None),
+    run_pipeline: bool = Form(True),
+):
+    """
+    Accepts a real drone image (JPG / PNG / GeoTIFF) uploaded by the user,
+    georeferences it around the supplied center coordinates, and (by default)
+    immediately runs the full GeoAI extraction pipeline (Modules 1-9) on the
+    real pixel data -- building footprints, road network, cadastral parcels,
+    LULC classification, topology conflicts, and benchmarks.
+    """
+    contents = await file.read()
+    if not contents:
+        raise HTTPException(status_code=400, detail="Uploaded file is empty")
+    if len(contents) > MAX_UPLOAD_BYTES:
+        raise HTTPException(status_code=413, detail="File too large (max 60MB)")
+
+    if not (-90.0 <= center_lat <= 90.0) or not (-180.0 <= center_lon <= 180.0):
+        raise HTTPException(status_code=400, detail="Invalid center_lat / center_lon")
+    if width_m <= 0 or height_m <= 0 or width_m > 5000 or height_m > 5000:
+        raise HTTPException(status_code=400, detail="width_m / height_m must be between 0 and 5000")
+
+    try:
+        metadata = ingest_uploaded_drone_image(
+            file_bytes=contents,
+            filename=file.filename or "uploaded_drone_image",
+            center_lat=center_lat,
+            center_lon=center_lon,
+            width_m=width_m,
+            height_m=height_m,
+            name=name,
+        )
+    except Exception as e:
+        raise HTTPException(status_code=400, detail=f"Could not process uploaded image: {e}")
+
+    aoi_id = metadata["aoi_id"]
+
+    if not run_pipeline:
+        return {"status": "success", "aoi_id": aoi_id, "metadata": metadata}
+
+    try:
+        ingest = IngestionPipeline(aoi_id).run_ingestion_and_preprocessing()
+        bld = BuildingFootprintExtractor(aoi_id).extract_building_footprints()
+        roads = RoadNetworkExtractor(aoi_id).extract_road_network()
+        parcels = ParcelBoundaryDelineator(aoi_id).delineate_parcels(
+            use_legacy_conflation=True, use_gnss_anchors=True
+        )
+        landuse = LandUseClassifier(aoi_id).classify_parcels()
+        topology = TopologyConflictEngine(aoi_id).detect_topology_and_conflicts()
+        benchmarks = EvaluationSuite(aoi_id).run_benchmarks()
+
+        return {
+            "status": "success",
+            "message": "Drone image uploaded and GeoAI feature extraction completed.",
+            "aoi_id": aoi_id,
+            "metadata": metadata,
+            "summary": {
+                "buildings_extracted": bld["total_buildings_extracted"],
+                "roads_extracted": roads["total_roads_extracted"],
+                "parcels_delineated": parcels["total_parcels_delineated"],
+                "conflicts_flagged": topology["total_conflicts_detected"],
+                "auto_mapped_pct": parcels["auto_mapped_percentage"],
+                "extraction_mode": "real-pixel RGB-only (no DSM/DTM survey supplied)",
+            },
+        }
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"Upload succeeded but pipeline failed: {e}")
