@@ -0,0 +1,119 @@
+import io
+import json
+import time
+from pathlib import Path
+from typing import Dict, Any, Optional
+
+import numpy as np
+import rasterio
+from rasterio.transform import from_origin
+from PIL import Image
+
+from ...core.config import settings
+from ...core.geo_utils import get_transformer
+
+Image.MAX_IMAGE_PIXELS = None  # allow large drone orthomosaics
+
+
+def _new_aoi_id() -> str:
+    return f"aoi_upload_{int(time.time() * 1000)}"
+
+
+def ingest_uploaded_drone_image(
+    file_bytes: bytes,
+    filename: str,
+    center_lat: float,
+    center_lon: float,
+    width_m: float = 300.0,
+    height_m: float = 300.0,
+    name: Optional[str] = None,
+    aoi_id: Optional[str] = None,
+) -> Dict[str, Any]:
+    """
+    Ingests a real user-supplied drone photo / orthomosaic (JPG, PNG or GeoTIFF)
+    that has NO existing georeferencing, and produces a properly georeferenced
+    GeoTIFF (orthomosaic_rgb.tif) inside a fresh AOI directory so it can be run
+    through the exact same downstream GeoAI extraction modules (buildings, roads,
+    parcels, LULC, conflicts, benchmarks) as the synthetic pilot AOIs.
+
+    Since a plain drone photo has no accompanying DSM/DTM survey, no nDSM height
+    layer is produced here -- the extraction modules fall back to genuine
+    RGB-only computer-vision techniques (edge/contour + spectral analysis)
+    instead of height-based segmentation.
+    """
+    aoi_id = aoi_id or _new_aoi_id()
+    aoi_dir = settings.DATA_DIR / "aois" / aoi_id
+    rasters_dir = aoi_dir / "rasters"
+    vectors_dir = aoi_dir / "vectors"
+    chips_dir = aoi_dir / "chips"
+    for d in (rasters_dir, vectors_dir, chips_dir):
+        d.mkdir(parents=True, exist_ok=True)
+
+    # 1. Decode the uploaded image (any common raster format Pillow understands,
+    #    including a GeoTIFF's pixel data -- we ignore any embedded georeferencing
+    #    since the user is supplying the real-world placement explicitly).
+    img = Image.open(io.BytesIO(file_bytes))
+    img = img.convert("RGB")
+    arr = np.array(img)  # H x W x 3
+    height_px, width_px = arr.shape[0], arr.shape[1]
+    band_data = np.transpose(arr, (2, 0, 1))  # 3 x H x W
+
+    # 2. Compute a real-world affine transform.
+    #    Reproject the supplied WGS84 center point into the project's UTM zone,
+    #    then place the image so it is centered there, spanning width_m x height_m,
+    #    north-up (standard drone orthomosaic convention).
+    transformer = get_transformer(settings.DEFAULT_GEOGRAPHIC_CRS, settings.DEFAULT_PROJECTED_CRS)
+    center_x, center_y = transformer.transform(center_lon, center_lat)
+
+    min_x = center_x - (width_m / 2.0)
+    max_y = center_y + (height_m / 2.0)
+    px_res_x = width_m / width_px
+    px_res_y = height_m / height_px
+
+    transform = from_origin(min_x, max_y, px_res_x, px_res_y)
+
+    # 3. Write the georeferenced GeoTIFF
+    rgb_path = rasters_dir / "orthomosaic_rgb.tif"
+    with rasterio.open(
+        rgb_path,
+        "w",
+        driver="GTiff",
+        height=height_px,
+        width=width_px,
+        count=3,
+        dtype=band_data.dtype,
+        crs=settings.DEFAULT_PROJECTED_CRS,
+        transform=transform,
+    ) as dst:
+        dst.write(band_data)
+
+    max_x = min_x + width_m
+    min_y = max_y - height_m
+
+    # 4. Build metadata.json in the same shape the rest of the platform expects
+    metadata = {
+        "aoi_id": aoi_id,
+        "name": name or f"Uploaded Drone Survey ({round(center_lat, 5)}, {round(center_lon, 5)})",
+        "location": f"User-Uploaded AOI ({round(center_lat, 5)}, {round(center_lon, 5)})",
+        "bounds_projected": [min_x, min_y, max_x, max_y],
+        "center_lat": round(center_lat, 6),
+        "center_lon": round(center_lon, 6),
+        "crs_projected": settings.DEFAULT_PROJECTED_CRS,
+        "crs_geographic": settings.DEFAULT_GEOGRAPHIC_CRS,
+        "image_size_px": [width_px, height_px],
+        "ground_resolution_m_per_px": round(px_res_x, 4),
+        "total_area_hectares": round((width_m * height_m) / 10000.0, 2),
+        "total_gt_parcels": 0,
+        "total_gt_buildings": 0,
+        "total_gt_roads": 0,
+        "total_gnss_points": 0,
+        "data_source": "user_uploaded_drone_image",
+        "source_filename": filename,
+        "has_dsm_dtm": False,
+        "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+    }
+
+    with open(aoi_dir / "metadata.json", "w", encoding="utf-8") as f:
+        json.dump(metadata, f, indent=2)
+
+    return metadata
